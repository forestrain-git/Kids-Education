{
  "version": "2.0",
  "envId": "kids-education-d8gak4uog7d6f09fa",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 5,
      "memorySize": 128,
      "handler": "index.main",
      "triggers": [
        {
          "name": "http",
          "type": "http",
          "config": {
            "method": "ANY",
            "path": "/api"
          }
        }
      ]
    }
  ]
}
